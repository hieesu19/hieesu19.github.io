---
import { navigation } from '../lib/navigation';
import TreeNode from '../components/TreeNode.astro';
import { allPosts, categoryName, categoryPath, sectionOf, urlOf } from '../lib/posts';
interface Props { title: string; description?: string; section?: string; currentPath?: string; }
const { title, description = 'Personal notes and projects.', section = '', currentPath = '' } = Astro.props;
const posts = await allPosts();
const categories = await navigation();
const searchIndex = posts.map(p => ({
  title: p.data.title, description: p.data.description, url: urlOf(p),
  section: categoryName(sectionOf(p)), folder: categoryName(categoryPath(p)), tags: p.data.tags,
}));
const json = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={description}/>
  <meta name="color-scheme" content="light dark"/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg"/>
  <link rel="stylesheet" href="/assets/style.css"/>
  <title>{title === 'hieesu19' ? 'hieesu19 — personal blog' : `${title} — hieesu19`}</title>
</head>
<body data-page={section || 'home'}>
  <a class="skip" href="#main">Skip to content</a>
  <div class="site-wrap">
    <aside class="sidebar" id="sidebar" aria-label="Main navigation">
      <div class="sidebar-inner">
        <a href="/" class="wordmark" aria-label="hieesu19, go to homepage">hieesu19</a>
        <div class="micro-label rail-intro">personal notes · 2026</div>
        <div class="rail-rule"></div>
        <div class="rail-label">CONTENTS <span>— {String(categories.length).padStart(2, '0')}</span></div>
        <nav class="tree" aria-label="Folders">
          {categories.map(item=><TreeNode item={item} currentPath={currentPath}/>)}
        </nav>
        <div class="rail-rule lower"></div>
        <a class={`small-side-link ${section==='about'?'is-here':''}`} href="/about/">About me <span class="sub-arrow">↗</span></a>
        <a class="small-side-link" href="#" id="sidebar-search">Search posts <span class="sub-arrow">⌕</span></a>
        <div class="rail-bottom"><span class="dot-small"></span> personal notes<br/><span class="muted">© 2026 hieesu19</span></div>
      </div>
    </aside>
    <div class="mobile-shade" id="mobile-shade"></div>
    <div class="content-shell">
      <header class="topbar">
        <button class="mobile-menu" aria-label="Open navigation" id="mobile-open"><span></span><span></span><span></span></button>
        <a href="/" class="mobile-brand">hieesu19</a>
        <span class="topbar-note">personal journal</span>
        <div class="topbar-right">
          <button class="icon-button" id="search-open" aria-label="Search posts" title="Search posts (Ctrl + K)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.7" cy="10.7" r="6.8"/><path d="m16 16 5 5"/></svg><span class="shortcut">Ctrl K</span></button>
          <button class="icon-button theme-button" id="theme-toggle" aria-label="Toggle color theme" title="Toggle theme"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 15.2A8.6 8.6 0 0 1 8.8 3.2 8.8 8.8 0 1 0 20.8 15.2Z"/></svg></button>
        </div>
      </header>
      <main class="main" id="main"><slot/></main>
      <footer class="footer"><span>© 2026 hieesu19</span><span>personal notes</span><a href="#main">Back to top ↑</a></footer>
    </div>
  </div>
  <div class="search-overlay" id="search-overlay" aria-hidden="true"><div class="search-dialog" role="dialog" aria-modal="true" aria-labelledby="search-title"><div class="search-head"><span id="search-title">Search the blog</span><button id="search-close" aria-label="Close search">Esc ×</button></div><div class="search-field"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.7" cy="10.7" r="6.8"/><path d="m16 16 5 5"/></svg><input id="search-input" placeholder="Search posts, tags, topics..." autocomplete="off" aria-label="Search query"/></div><div id="search-results" class="search-results"></div><div class="search-help">Enter to open · Esc to close · Search titles, categories or tags</div></div></div>
  <div class="lightbox" id="lightbox" aria-hidden="true"><button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close photo">×</button><button type="button" class="lightbox-prev" id="lightbox-prev" aria-label="Previous photo">‹</button><div class="lightbox-center"><img id="lightbox-img" alt="Full-size photo"/><div class="lightbox-caption" id="lightbox-caption"></div></div><button type="button" class="lightbox-next" id="lightbox-next" aria-label="Next photo">›</button></div>
  <script id="search-index" type="application/json" set:html={json}/>
  <script src="/assets/site.js" defer is:inline></script>
</body>
</html>
