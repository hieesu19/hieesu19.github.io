---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { displayDate, categoryName, categoryPath, breadcrumbPaths, categoryUrl, sectionOf } from '../../lib/posts';
import { photos } from '../../lib/photos';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content } = await render(post);
const section = sectionOf(post);
const path = categoryPath(post);
const crumbs = breadcrumbPaths(path);
const label = categoryName(section);
const folderLabel = categoryName(path);
const image = post.data.image ? `/assets/photos/${post.data.image}.jpg` : undefined;
---
<SiteLayout title={post.data.title} description={post.data.description} section={section} currentPath={path}>
  <article class="article">
    <div class="bread"><a href="/">Home</a>{crumbs.map(crumb => <><span>/</span><a href={crumb.href}>{crumb.name}</a></>)}</div>
    <header class="article-head">
      <span class="eyebrow">{label} / {folderLabel}</span>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="article-meta"><span>{displayDate(post.data.date)}</span>{post.data.read && <><span>·</span><span>{post.data.read} min read</span></>}</div>
    </header>
    {image && <figure class="article-hero"><img src={image} alt={post.data.title} loading="eager"/><figcaption>Sample photograph.</figcaption></figure>}
    {section === 'book' && <div class="article-book-by">{post.data.author ?? ''}<span>·</span>{post.data.status ?? ''}</div>}
    <div class="article-text"><Content/></div>
    {post.data.gallery && <div class="article-gallery">{post.data.gallery.map(file => <button type="button" class="article-photo" data-photo={photos.findIndex(p=>p.file===file)}><img src={`/assets/photos/${file}.jpg`} alt={file} loading="lazy"/></button>)}</div>}
    <div class="article-end"><div class="article-tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div><a href={categoryUrl(path)} class="inline-cta">← Back to {folderLabel}</a></div>
  </article>
</SiteLayout>
