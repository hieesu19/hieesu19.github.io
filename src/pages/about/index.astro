---
import SiteLayout from '../../layouts/SiteLayout.astro';
---
<SiteLayout title="About me" section="about">
  <div class="page-intro about-intro"><h1>About me<span class="period">.</span></h1></div>
  <div class="about-layout">
    <div class="about-prose">
      <p>I'm hieesu19. I study cybersecurity, with a focus on reverse engineering, malware analysis and digital forensics.</p>
      <p>This is where I keep my technical work, personal projects, photos, everyday stories and book notes.</p>
      <p class="about-note">Replace this introduction and the example photos with your own.</p>
    </div>
    <figure class="about-image"><img src="/assets/photos/bookshop.jpg" alt="Bookshop interior"/><figcaption>Sample photo</figcaption></figure>
  </div>
</SiteLayout>
